# Development Compose only. Replace values before any non-local deployment.
PAPYR_DB_PASSWORD=replace-this-development-password
# Explicit one-time database-password repair and administrator recovery; disable after recovery.
PAPYR_RESET_DB_PASSWORD=false
# Required while recovery is enabled. Set private credentials; existing administrator data is preserved.
PAPYR_ADMIN_USERNAME=
PAPYR_ADMIN_PASSWORD=
PAPYR_INITIAL_SETUP_TOKEN=
# Set true temporarily to keep failed API startup logs available in Portainer.
PAPYR_API_DIAGNOSTICS=false
# Keep the web service gated on API health; use service_started only while diagnosing API startup.
PAPYR_API_START_CONDITION=service_healthy
# Host port for the web app (keep the service private behind your reverse proxy).
PAPYR_WEB_PORT=6767
# Public hostname for the optional TLS reverse proxy (Compose profile "tls").
# Must be a public DNS name pointing at this host with ports 80/443 reachable;
# Caddy obtains a Let's Encrypt certificate automatically. HTTPS is required for
# PWA installation (service workers only run in a secure context).
# PAPYR_DOMAIN=papyr.example.com
# Stable IP of the Caddy proxy on the Compose network (change together with the
# other PAPYR_*_IP values if the default subnet conflicts).
# PAPYR_PROXY_IP=10.253.0.5
# Change events are retained for this many days (1–3650).
PAPYR_CHANGE_RETENTION_DAYS=90
# Keep enabled for the single API instance in the supplied Compose stack.
PAPYR_MIGRATE_ON_STARTUP=true
# Local HTTP only. Set true when serving over HTTPS (required with the "tls" profile).
PAPYR_COOKIE_SECURE=false
# Maximum total attachment bytes allowed per owner (default: 1 GiB).
PAPYR_MAX_ASSET_STORAGE_BYTES=1073741824
# Change these together if the default subnet conflicts with an existing Docker network.
PAPYR_NETWORK_SUBNET=10.253.0.0/24
PAPYR_WEB_IP=10.253.0.2
PAPYR_API_IP=10.253.0.3
PAPYR_DB_IP=10.253.0.4
# Leave unset until a valid license for the target use/domain has been obtained.
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
