{
  "name": "@papyr/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "predev": "node scripts/copy-typst-assets.mjs",
    "prebuild": "node scripts/copy-typst-assets.mjs",
    "start": "next start",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test && playwright test -c playwright.dev.config.ts",
    "test:sync-e2e": "playwright test -c playwright.sync.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.11.3",
    "@codemirror/state": "6.7.6",
    "@lezer/highlight": "1.2.5",
    "@microsoft/signalr": "10.0.0",
    "@tldraw/assets": "5.5.2",
    "@typst-wasm/fonts": "1.0.0",
    "codemirror": "6.0.2",
    "dexie": "4.4.6",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldraw": "5.5.2",
    "typst-wasm": "1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "6.2.4",
    "prettier": "3.8.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.12.0"
}
